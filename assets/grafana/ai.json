          "legendFormat": "p50 {{api_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, api_type) (rate(trelliskit_ai_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p95 {{api_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
